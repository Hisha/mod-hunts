# Hunts - standalone AzerothCore hunting gameplay module

Hunts.Enable = 1
Hunts.Debug = 1
Hunts.MinimumLevel = 10

# 0 = Local Region, 1 = Continent, 2 = World
Hunts.SearchScope = 0

# Completion XP multiplier for all Hunts. Default preserves current tuning.
Hunts.XPMultiplier = 0.75

# ----------------------------------------------------------
# Tracking / group credit
# ----------------------------------------------------------
# Random tracking progress awarded for a qualifying ordinary kill.
Hunts.Tracking.ProgressMin = 3
Hunts.Tracking.ProgressMax = 7

# Same-hunt group members must be within this many yards for ordinary kill credit.
Hunts.GroupCreditRadius = 100.0

# Same-final group members must be within this many yards for shared final credit.
Hunts.SharedFinalCreditRadius = 200.0

# ----------------------------------------------------------
# Elite Hunts
# ----------------------------------------------------------
# Completed normal Hunts required before Elite Hunts unlock.
Hunts.Elite.RequiredNormalCompletions = 10

# Successful Elite Hunt turn-ins allowed per character per day.
Hunts.Elite.DailyLimit = 1

# Global difficulty multipliers applied on top of each Elite prey's DB tuning.
# 1.0 = authored/default difficulty. Example hard server: 1.75 / 1.35 / 1.20.
Hunts.Elite.HealthMultiplier = 1.0
Hunts.Elite.DamageMultiplier = 1.0
Hunts.Elite.ArmorMultiplier = 1.0

# Additional Elite-only reward multipliers. These stack with Hunts.XPMultiplier
# and the individual prey reward_multiplier from hunt_prey.
Hunts.Elite.XPMultiplier = 1.0
Hunts.Elite.GoldMultiplier = 1.0

# Huntmaster's Seals are endgame progression currency. Characters below this
# level never receive Seals, even when they complete an Elite Hunt.
Hunts.Elite.SealMinimumLevel = 80
Hunts.Elite.SealsPerCompletion = 1

# At this level, Elite random gear switches to the configured endgame item-level
# band. Defaults to entry-level Wrath 10-player raid gear only.
Hunts.Elite.EndgameRewardLevel = 80
Hunts.Elite.EndgameRewardMinItemLevel = 200
Hunts.Elite.EndgameRewardMaxItemLevel = 200

# Elite random gear can be restricted to actual upgrades over the character's
# currently equipped item in the matching slot. UpgradePoolPct controls how
# close a candidate must be to the best detected upgrade to enter the random
# selection pool. 0.70 = within the best 70% upgrade band.
Hunts.Elite.RewardRequireUpgrade = 1
Hunts.Elite.RewardUpgradePoolPct = 0.70

# Ranged Elite combat behavior. PanicRange is where escape tools such as Blink
# become eligible. RetreatRangePct is multiplied by each prey's SQL preferred_range
# when a root/slow creates a kiting opportunity. ReactionMs controls how often
# movement decisions are reconsidered. Blink defaults to the Wrath Mage 15s cooldown.
# ArenaRadius is the soft radius around the prey's encounter spawn/home position;
# ranged prey kite inside it and re-center before stock creature evade can trigger.
Hunts.Elite.Ranged.PanicRange = 10.0
Hunts.Elite.Ranged.RetreatRangePct = 1.0
Hunts.Elite.Ranged.BlinkCooldownMs = 15000
Hunts.Elite.Ranged.ReactionMs = 500
Hunts.Elite.Ranged.ArenaRadius = 35.0


# ----------------------------------------------------------
# Huntmaster's Seal Store
# ----------------------------------------------------------
# The stock-client store uses Huntmaster gossip so the displayed Seal costs
# always match what the server actually charges. Cost = 0 disables a tier.
# Item-level bands are intentionally server configurable. Heroic-flagged items
# are always excluded by the module regardless of these bands.
Hunts.SealStore.Tier1.Cost = 5
Hunts.SealStore.Tier1.MinItemLevel = 213
Hunts.SealStore.Tier1.MaxItemLevel = 219

Hunts.SealStore.Tier2.Cost = 10
Hunts.SealStore.Tier2.MinItemLevel = 226
Hunts.SealStore.Tier2.MaxItemLevel = 232

Hunts.SealStore.Tier3.Cost = 20
Hunts.SealStore.Tier3.MinItemLevel = 245
Hunts.SealStore.Tier3.MaxItemLevel = 251

Hunts.SealStore.Tier4.Cost = 30
Hunts.SealStore.Tier4.MinItemLevel = 264
Hunts.SealStore.Tier4.MaxItemLevel = 264
